{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xero Systems Monitor",
  "identifier": "io.github.xerosystemsmonitor",
  "build": {
    "frontendDist": "../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Xero Systems Monitor",
        "width": 980,
        "height": 900,
        "minWidth": 360,
        "minHeight": 400,
        "visible": false,
        "backgroundColor": "#07080b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1QUVEMEE2MTBGNzg2QTAKUldTZ2h2Y1FwdEN1bFNIZE01d1V5ZTY4Vjk0SEFyMXdTV3pTNWxIZnhTQU53aDYvWkxuRzFiVC8K",
      "endpoints": ["https://github.com/T3rM1nAt0-R/xero-systems-monitor/releases/latest/download/latest.json"]
    }
  }
}
